{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug AM Stereo Receiver",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/cpp-am-stereo-receiver/build/am_stereo_receiver",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}/cpp-am-stereo-receiver",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "Build Debug",
            "miDebuggerPath": "/usr/bin/gdb"
        },
        {
            "name": "CMake: CMake Script",
            "type": "cmake",
            "request": "launch",
            "cmakeDebugType": "script",
            "scriptPath": "${file}"
        }
    ]
}
